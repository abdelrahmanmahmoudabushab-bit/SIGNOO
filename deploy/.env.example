# Copy to deploy/.env and fill in. deploy/.env is never committed (see .gitignore).
#
# Generate each secret with:   openssl rand -hex 32

# The domain whose DNS A record points at the droplet. Caddy gets the certificate for it.
SIGNOO_DOMAIN=signoo.example.com

POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-32

# Signs the console's login tokens. The server refuses to start if this is short or default.
SIGNOO_JWT_SECRET=change-me-with-openssl-rand-hex-32

# The issuing key for kiosk credentials. In per_kiosk mode it never leaves the server and
# each kiosk gets its own derived token (python -m server.scripts.kiosk_token <kiosk_id>).
SIGNOO_KIOSK_TOKEN=change-me-with-openssl-rand-hex-32
SIGNOO_KIOSK_TOKEN_MODE=per_kiosk

# Which sign languages the automatic 3-day cycle trains, comma separated. A language is
# trained from its own reviewed data and gated against its own benchmark.
SIGNOO_AUTO_TRAIN=1
SIGNOO_AUTO_TRAIN_LANGUAGES=liu
SIGNOO_AUTO_TRAIN_HOURS=72

# Unreviewed visitor clips are deleted after this many days (0 = keep forever).
SIGNOO_RETENTION_DAYS=30

# Stamped into model version names; `git rev-parse --short HEAD` on the machine you build from.
SIGNOO_CODE_COMMIT=unknown
