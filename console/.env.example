# Copy to .env.local and point at a running server/ (B16 Console API) to use real data.
# Leaving this unset (or blank) makes every screen fall back to seeded mock data automatically.
VITE_API_BASE_URL=http://localhost:8000

# Set to 1 to force mock data even if VITE_API_BASE_URL is reachable (useful for demos).
VITE_USE_MOCKS=0
